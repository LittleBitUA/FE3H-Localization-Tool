{
  "name": "fe3h-localization-tool",
  "version": "0.1.0",
  "description": "FE3H Localization Tool — extract, translate, reinsert and deploy game text for Fire Emblem: Three Houses (Switch)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "set ELECTRON_RUN_AS_NODE= && electron-vite dev",
    "build": "electron-vite build",
    "preview": "set ELECTRON_RUN_AS_NODE= && electron-vite preview",
    "start": "set ELECTRON_RUN_AS_NODE= && electron .",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "productName": "FE3H Localization Tool",
  "author": "Dmytro Bidlov («Little Bit» Team)",
  "license": "MIT",
  "build": {
    "appId": "team.littlebit.fe3h-localization-tool",
    "productName": "FE3H Localization Tool",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "python-runtime",
        "to": "python-runtime"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FE3H-Localization-Tool-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "FE3H-Localization-Tool-Portable-${version}.${ext}"
    }
  }
}
